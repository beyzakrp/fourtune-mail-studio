    "html": "<!DOCTYPE html>\n<html lang=\"tr\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<title>{{subject}}</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Shadows+Into+Light+Two&family=Instrument+Serif:ital@0;1&display=swap\" rel=\"stylesheet\">\n<!--[if mso]>\n<style type=\"text/css\">\n  body, table, td { font-family: Arial, Helvetica, sans-serif !important; }\n</style>\n<![endif]-->\n<style>\n  .elms-sans-regular {\n    font-family: \"Elms Sans\", Arial, Helvetica, sans-serif;\n    font-optical-sizing: auto;\n    font-weight: 400;\n    font-style: normal;\n  }\n  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n  img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }\n  body { margin: 0; padding: 0; width: 100% !important; background-color: #efefef; }\n  a { text-decoration: none; }\n  @media only screen and (max-width: 620px) {\n    .email-container { width: 100% !important; }\n    .footer-shell { padding-left:6px !important; padding-right:6px !important; }\n    .footer-padding { padding-left:20px !important; padding-right:20px !important; }\n    .fluid-img { width: 100% !important; height: auto !important; }\n  }\n</style>\n<link href=\"https://fonts.googleapis.com/css2?family=Elms+Sans:wght@400&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background-color:#efefef;\">\n<!-- preheader (inbox preview text, hidden) -->\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">{{preheader}}</div>\n\n<center style=\"width:100%;background-color:#efefef;\">\n<!--[if mso]>\n<table role=\"presentation\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td>\n<![endif]-->\n<table role=\"presentation\" class=\"email-container\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px;max-width:600px;margin:0 auto;background-color:#ffffff;\">\n\n  <!-- ============ HEADER NAV ============ -->\n \n\n  <!-- ============ HERO: ZARF + HELLO + EL YAZISI ALINTI ============ -->\n  <tr>\n    <td style=\"padding:0;\">\n     <div style=\"position:relative;width:600px;height:874px;overflow:hidden;background:#ffffff;\">\n        <!-- zarf + mühür fotoğrafı (marka bağımsız, sabit görsel) -->\n        <img src=\"{{image0}}\"\n             width=\"796\" height=\"839\" alt=\"\"\n             style=\"position:absolute;left:-85px;top:35px;width:796px;height:839px;\">\n        <!-- ikincil görsel katman (yumuşak gölge/doku) -->\n        <img src=\"{{image1}}\"\n             width=\"215\" height=\"182\" alt=\"\"\n             style=\"position:absolute;left:168px;top:450px;width:215px;height:182px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto; padding:40px 0 0 0;\">\n        <tr>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding-right:6px;font-size:0;line-height:0;\">\n            <img src=\"{{image2}}\" width=\"53\" height=\"10\" alt=\"4tune\" style=\"display:block;height:10px;width:53px;\">\n          </td>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding:0 6px;font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:22px;line-height:22px;color:#000000;\">x</td>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding-left:6px;font-size:0;line-height:0;\">\n            <!-- [BRAND_LOGO_SRC] : marka logosu (şeffaf PNG önerilir) -->\n            <img src=\"{{image3}}\" width=\"90\" height=\"17\" alt=\"Example Brand\" style=\"display:block;height:17px;width:90px;\">\n          </td>\n        </tr>\n      </table>\n      <!-- HELLO! başlığı -->\n        <div style=\"position:absolute;left:0;top:75px;width:600px;text-align:center;\n                    font-family:'SF Pro Display',-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;\n                    font-size:150px;line-height:0.86;font-weight:400;color:#1e1e1e;letter-spacing:-2px;\">\n          HELLO!\n        </div>\n       \n        <!-- el yazısı alıntı — [HANDWRITTEN_QUOTE] : marka adına göre değiştir -->\n        <div style=\"position:absolute;left:135px;top:311px;width:329px;text-align:center;\n                    font-family:'Shadows Into Light Two',cursive;font-size:28px;line-height:32px;color:#000000;\">{{quote}}</div>\n        <!-- site linki -->\n        <div style=\"position:absolute;left:0;top:718px;width:600px;text-align:center;\n                    font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;\n                    font-size:18px;line-height:26px;color:rgba(30,30,30,0.5);\">\n          www.example.com\n        </div>\n      </div>\n    </td>\n  </tr>\n\n  <!-- ============ WEBSITE REVIEW: FOTO KOLAJ (tek parça görsel) ============ -->\n  <tr>\n    <td style=\"padding:0;background:#ffffff;\">\n      <div style=\"width:600px;overflow:hidden;margin:0 auto;\">\n        <!-- [WEBSITE_COLLAGE_SRC] : bu görsel her marka için Figma'da ayrı ayrı\n             hazırlanıp \"Group 252\" olarak tek parça export edilmeli -->\n        <img src=\"{{image4}}\"\n             width=\"680\" height=\"377\" alt=\"Website Review\"\n             style=\"width:680px;height:377px;margin-left:-41px;display:block;\">\n      </div>\n    </td>\n  </tr>\n\n  <!-- ============ PARAGRAF 1 ============ -->\n  <tr>\n    <td style=\"padding:56px 32px 0 32px;text-align:center;background:#ffffff;\">\n      <!-- [BODY_INTRO_TEXT_1] -->\n      <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;\n                font-weight:500;font-size:23px;line-height:30px;color:#1e1e1e;\">{{intro}}</p>\n    </td>\n  </tr>\n\n  <!-- ============ \"KİLİTLİ\" WEB SİTESİ İNCELEME GÖRSELİ ============ -->\n  <tr>\n    <td style=\"padding:60px 0 0 0;text-align:center;background:#ffffff;\">\n      <a href=\"{{showcaseUrl}}\" target=\"_blank\" style=\"display:inline-block;position:relative;width:466px;height:512px;\">\n        <!-- [LOCKED_SHOWCASE_SRC] -->\n        <img src=\"{{image5}}\"\n             width=\"466\" height=\"512\" alt=\"Web sitesi incelemesi\" style=\"display:block;width:466px;height:512px;\">\n        <!-- alt yarıyı beyaza soldüren \"kilitli içerik\" katmanı -->\n        <div style=\"position:absolute;left:0;top:200px;width:466px;height:312px;\n                    background:linear-gradient(to bottom, rgba(255,255,255,0) 0%, #ffffff 55%);\"></div>\n        <img src=\"{{image6}}\"\n             width=\"56\" height=\"57\" alt=\"\"\n             style=\"position:absolute;left:200px;top:390px;width:56px;height:57px;\">\n        <div style=\"position:absolute;left:0;top:445px;width:466px;text-align:center;\n                    font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;\n                    font-size:14px;letter-spacing:1px;text-transform:uppercase;color:#312c2d;\">\n          Tüm Dosyanın Kilidini Aç\n        </div>\n      </a>\n    </td>\n  </tr>\n\n  <!-- ============ KONFETİ / ÇİÇEK ŞERİDİ ============ -->\n  <tr>\n    <td style=\"padding:0;background:#ffffff;\">\n      <div style=\"width:600px;overflow:hidden;margin:0 auto;\">\n        <img src=\"{{image7}}\"\n             width=\"630\" height=\"34\" alt=\"\"\n             style=\"width:630px;height:34px;margin-left:-15px;display:block;\">\n      </div>\n    </td>\n  </tr>\n\n  <!-- ============ PARAGRAF 2 ============ -->\n  <tr>\n    <td style=\"padding:40px 32px 0 32px;text-align:center;background:#ffffff;\">\n      <!-- [BODY_INTRO_TEXT_2] -->\n      <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;\n                font-weight:500;font-size:23px;line-height:30px;color:#000000;\">{{body}}</p>\n    </td>\n  </tr>\n\n    <!-- ============ KÜÇÜK LOGO (CTA altı) ============ -->\n  <tr>\n    <td style=\"padding:35px 0 20px 0;text-align:center;background:#ffffff;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto;\">\n        <tr>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding-right:6px;font-size:0;line-height:0;\">\n            <img src=\"{{image8}}\" width=\"53\" height=\"10\" alt=\"4tune\" style=\"display:block;height:10px;width:53px;\">\n          </td>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding:0 6px;font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:22px;line-height:22px;color:#000000;\">x</td>\n          <td valign=\"middle\" height=\"24\" style=\"height:24px;vertical-align:middle;padding-left:6px;font-size:0;line-height:0;\">\n            <img src=\"{{image9}}\" width=\"60\" height=\"13\" alt=\"Example Brand\" style=\"display:block;height:13px;width:60px;\">\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n\n  <!-- ============ ETİKET / TAGLINE ============ -->\n  <tr>\n    <td style=\"padding:10px 0 0 0;text-align:center;background:#ffffff;\">\n      <p style=\"margin:0;font-family:'Instrument Serif',Georgia,serif;font-style:italic;\n                font-size:25px;line-height:30px;color:#000000;\">{{tagline}}</p>\n    </td>\n  </tr>\n\n  <!-- ============ CTA BUTONU ============ -->\n  <tr>\n    <td style=\"padding:20px 0 0 0;text-align:center;background:#ffffff;\">\n      <!--[if mso]>\n      <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" href=\"{{ctaUrl}}\" style=\"height:51px;v-text-anchor:middle;width:440px;\" arcsize=\"70%\" fillcolor=\"#f52e63\" stroke=\"f\">\n      <w:anchorlock/>\n      <center style=\"color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:600;\">{{cta}}</center>\n      </v:roundrect>\n      <![endif]-->\n      <!--[if !mso]><!-- -->\n      <a href=\"{{ctaUrl}}\" target=\"_blank\" style=\"display:inline-block;background-color:#f52e63;color:#ffffff;\n         font-family:Arial,Helvetica,sans-serif;font-weight:600;font-size:17px;line-height:51px;\n         width:440px;height:51px;border-radius:26px;text-align:center;\">{{cta}}</a>\n      <!--<![endif]-->\n    </td>\n  </tr>\n\n  <!-- ============ İKİNCİL LİNK ============ -->\n  <tr>\n    <td style=\"padding:16px 0 20px 0;text-align:center;background:#ffffff;\">\n      <a href=\"{{secondaryUrl}}\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1e1e1e;text-decoration: underline;\">{{secondary}}</a>\n    </td>\n  </tr>\n\n\n  <!-- ============ FOOTER ============ -->\n  <tr>\n    <td class=\"footer-shell\" bgcolor=\"#ffffff\" style=\"padding:12px 6px 6px;background-color:#ffffff;\">\n      <div style=\"background:#000000;border-radius:36px 36px 0 0;overflow:hidden;position:relative;height:200px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"footer-card elms-sans-regular\" style=\"width:100%;background-color:transparent;border-collapse:separate;border-spacing:0;position:relative;z-index:1;\">\n        <tr>\n          <td valign=\"top\" class=\"footer-padding\" style=\"padding:26px 30px 0;position: relative;top: 0;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td valign=\"top\" width=\"55%\" style=\"font-family:'Elms Sans',Arial,Helvetica,sans-serif;font-optical-sizing:auto;font-weight:400;font-style:normal;font-size:10px;line-height:18px;color:#ffffff;\">\n                  <a href=\"#\" style=\"color:#ffffff;display:block;\">Biz Kimiz?</a>\n                  <a href=\"#\" style=\"color:#ffffff;display:block;\">Hizmetlerimiz</a>\n                  <a href=\"#\" style=\"color:#ffffff;display:block;\">Portfolio</a>\n                  <a href=\"#\" style=\"color:#ffffff;display:block;\">İletişim</a>\n                </td>\n                <td valign=\"top\" width=\"45%\" align=\"right\" style=\"font-family:'Elms Sans',Arial,Helvetica,sans-serif;font-optical-sizing:auto;font-weight:400;font-style:normal;font-size:8px;line-height:11px;color:#808080;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td align=\"right\" style=\"padding-bottom:11px;font-family:'Elms Sans',Arial,Helvetica,sans-serif;font-optical-sizing:auto;font-weight:400;font-style:normal;font-size:8px;line-height:11px;\">\n                        <a href=\"https://example.com/tr/privacy\" style=\"color:#808080;\">Gizlilik</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n                        <a href=\"https://example.com/tr/terms\" style=\"color:#808080;\">Koşullar</a>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td align=\"right\" style=\"padding-bottom:8px;\">\n                        <a href=\"#\" style=\"display:inline-block;\"><img src=\"{{image10}}\" width=\"162\" height=\"16\" alt=\"Instagram, TikTok, LinkedIn, Behance, Pinterest, Dribbble, Figma\" style=\"width:162px;max-width:100%;height:auto;\"></a>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td align=\"right\" style=\"border-top:1px solid #808080;padding-top:6px;font-family:'Elms Sans',Arial,Helvetica,sans-serif;font-optical-sizing:auto;font-weight:400;font-style:normal;font-size:8px;line-height:11px;color:#808080;\">\n                        <address style=\"margin:0;font-style:normal;\">Example business address<br>Example City</address>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td align=\"right\" style=\"padding-top:10px;font-family:'Elms Sans',Arial,Helvetica,sans-serif;font-optical-sizing:auto;font-weight:400;font-style:normal;font-size:8px;line-height:11px;\">\n                        <a href=\"mailto:hello@example.com\" style=\"color:#ffffff;\">hello@example.com</a><br>\n                        <a href=\"https://www.example.com\" style=\"color:#ffffff;\">www.example.com</a><br>\n                        <p style=\"margin:3px 0 0;color:#808080;font-size:8px;line-height:11px;\">© 2026 <span style=\"font-weight:400;\">4tune</span> Agency. Tüm hakları saklıdır.</p>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n      <!-- Alt kenara sabitlenen logo kart sınırında kırpılır. -->\n      <a href=\"https://example.com/tr\" aria-label=\"Fourtune — Ana Sayfa\" style=\"display:block;position:absolute;left:0;bottom:-40px;width:100%;font-size:0;line-height:0;\">\n              <img src=\"{{image11}}\"\n                   width=\"588\" alt=\"4tune\" style=\"display:block;width:100%;height:auto;border:0;\">\n            </a>\n      </div>\n    </td>\n  </tr>\n</table>\n<!--[if mso]>\n</td></tr></table>\n<![endif]-->\n</center>\n</body>\n</html>\n",
